DATABASE_URL="postgresql://kafalah:kafalah@localhost:5432/kafalah_visits?schema=public"

BETTER_AUTH_SECRET="change-me-to-a-long-random-string-32+chars"

# ===== التطبيقان منفصلان: واجهة الزوّار + لوحة الإدارة =====
# الخادم (API) واحد يخدم التطبيقين. كل واجهة تنادي /api على نطاقها نفسه (same-origin).
# الاعتماد (auth) يحدث في لوحة الإدارة فقط، لذلك BETTER_AUTH_URL = نطاق الإدارة.

API_PORT=8787

# --- التطوير المحلي (الافتراضي) ---
# الزوّار 5173 · الإدارة 5174 · الخادم 8787 (الواجهتان تناديان الخادم 8787 مباشرة)
BETTER_AUTH_URL="http://localhost:8787"
WEB_ORIGIN="http://localhost:5173"
ADMIN_ORIGIN="http://localhost:5174"
PUBLIC_WEB_URL="http://localhost:5173"

# --- نطاق مؤقت (مثال: IP السيرفر) : الزوّار على 80 ، الإدارة على 8081 ---
# BETTER_AUTH_URL="http://SERVER_IP:8081"
# WEB_ORIGIN="http://SERVER_IP"
# ADMIN_ORIGIN="http://SERVER_IP:8081"
# PUBLIC_WEB_URL="http://SERVER_IP"

# --- نطاقان نهائيان ---
# BETTER_AUTH_URL="https://control.ramh.sa"
# WEB_ORIGIN="https://visits.ramh.sa"
# ADMIN_ORIGIN="https://control.ramh.sa"
# PUBLIC_WEB_URL="https://visits.ramh.sa"

# يُستخدم وقت البناء لكل واجهة على حدة (انظر deploy/HOSTINGER.md):
#   واجهة الزوّار:  VITE_API_URL = نطاق الزوّار
#   لوحة الإدارة:   VITE_API_URL = نطاق الإدارة
VITE_API_URL="http://localhost:8787"

SEED_ADMIN_EMAIL="admin@kafalah.sa"
SEED_ADMIN_PASSWORD="Kafalah@2026"
