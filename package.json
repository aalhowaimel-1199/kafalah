{
  "name": "kafalah-visits",
  "version": "1.0.0",
  "private": true,
  "description": "نظام زيارة كفالة — بوابة الزيارات وربط البوابات BioTime",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "node scripts/build-api.mjs",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @ramh/db generate",
    "db:migrate": "pnpm --filter @ramh/db migrate",
    "db:deploy": "pnpm --filter @ramh/db deploy",
    "db:seed": "pnpm --filter @ramh/db seed",
    "db:studio": "pnpm --filter @ramh/db studio",
    "bootstrap": "pnpm --filter @ramh/api bootstrap",
    "sweep": "pnpm --filter @ramh/api sweep"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
